<Window x:Class="Keyboop.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Keyboop for Windows — тестовая сборка" Width="760" Height="650"
    MinWidth="720" MinHeight="620" WindowStartupLocation="CenterScreen"
    Background="#1C1B1A" Foreground="#F5F1EC">
  <Grid Margin="32">
    <StackPanel>
      <TextBlock Text="KEYBOOP / WINDOWS" Foreground="#FF7A59"
                 FontSize="14" FontWeight="SemiBold"/>
      <TextBlock Text="Исправление раскладки" FontSize="29"
                 FontWeight="SemiBold" Margin="0,14,0,8"/>
      <TextBlock TextWrapping="Wrap" Foreground="#BFB9B4"
                 Text="Ранняя тестовая версия · ручной режим · без буфера обмена"
                 Margin="0,0,0,22"/>
      <Border Background="#302D29" CornerRadius="12" Padding="18">
        <StackPanel>
          <TextBlock Text="1. Проверь таблицу преобразования" FontSize="18"
                     FontWeight="SemiBold" Margin="0,0,0,10"/>
          <TextBlock Text="Введи ghbdtn и нажми «Преобразовать пример». Этот тест не использует глобальный перехват."
                     TextWrapping="Wrap" Foreground="#C9C4BE" Margin="0,0,0,10"/>
          <TextBox x:Name="PreviewInput" Text="ghbdtn" FontSize="18"
                   Height="39" Padding="9,6" Foreground="#F5F1EC"
                   Background="#252321" BorderBrush="#69574B"/>
          <Button x:Name="PreviewButton" Content="Преобразовать пример"
                  Click="PreviewClick" HorizontalAlignment="Left"
                  Padding="16,8" Margin="0,12,0,0"/>
        </StackPanel>
      </Border>
      <Border Background="#302D29" CornerRadius="12" Padding="18" Margin="0,18,0,0">
        <StackPanel>
          <TextBlock Text="2. Проверь настоящий ввод клавиатуры"
                     FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
          <TextBlock TextWrapping="Wrap" Foreground="#C9C4BE"
                     Text="Нажми «Включить тест». В поле выше или в обычном Блокноте набери ghbdtn без пробела, затем Ctrl + Alt + Space. Отпусти все три клавиши. Исправление должно произойти после отпускания."
                     Margin="0,0,0,16"/>
          <Button x:Name="ToggleButton" Content="Включить тест перехвата"
                  HorizontalAlignment="Left" Padding="16,9" Click="ToggleClick"/>
          <TextBlock x:Name="StatusLabel" Text="Перехват выключен"
                     Foreground="#FFB48A" TextWrapping="Wrap" Margin="0,14,0,0"/>
        </StackPanel>
      </Border>
      <TextBlock Text="Внимание: для первого теста допускаются только это окно и Блокнот. Остальные приложения игнорируются."
                 TextWrapping="Wrap" Foreground="#E1B38B" Margin="0,18,0,0"/>
      <TextBlock Text="Нет автокоррекции, отслеживания паролей и поддержки повышенных прав. Не использовать для рабочих документов и секретных данных."
                 TextWrapping="Wrap" Foreground="#BDB6B0" FontSize="12"
                 Margin="0,12,0,0"/>
      <TextBlock Text="Оригинальный Keyboop © Ivan Smetanin (MIT) · Независимый Windows-порт"
                 Foreground="#968D86" FontSize="11" Margin="0,20,0,0"/>
    </StackPanel>
  </Grid>
</Window>